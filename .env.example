# Copy this file to .env and fill in values before running in production.

# Django core
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=3600

# Database (PostgreSQL)
DB_ENGINE=postgresql
POSTGRES_DB=bidding_db
POSTGRES_USER=bidding_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Optional alternative to the POSTGRES_* variables:
# DATABASE_URL=******db:5432/bidding_db
# POSTGRES_SSLMODE=require

# Cache / Celery broker (Redis)
REDIS_URL=redis://redis:6379/0
